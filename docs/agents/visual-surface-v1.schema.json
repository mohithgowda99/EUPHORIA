{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://euphoria.example/contracts/visual-surface/v1",
  "title": "EUPHORIA VisualSurface v1 (prototype subset, not complete A2UI)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "surfaceID", "revision", "nodes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "surfaceID": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision": {"type": "integer", "minimum": 0},
    "nodes": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "title"],
      "properties": {
        "id": {"type":"string", "minLength":1, "maxLength":64},
        "kind": {"enum":["askChoice","askForm","askApproval","showChecklist","pageChecklist"]},
        "title": {"type":"string", "minLength":1, "maxLength":120},
        "summary": {"type":["string","null"], "maxLength":500},
        "options": {"type":"array", "maxItems":20, "items":{"$ref":"#/$defs/option"}},
        "fields": {"type":"array", "maxItems":8, "items":{"$ref":"#/$defs/field"}},
        "items": {"type":"array", "maxItems":50, "items":{"$ref":"#/$defs/checklistItem"}}
      }
    },
    "option": {
      "type":"object", "additionalProperties":false,
      "required":["id","label"],
      "properties": {
        "id":{"type":"string", "minLength":1},
        "label":{"type":"string", "minLength":1},
        "description":{"type":["string","null"]}
      }
    },
    "field": {
      "type":"object", "additionalProperties":false,
      "required":["id","label","type","required"],
      "properties": {
        "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_]{0,47}$"},
        "label":{"type":"string","minLength":1,"maxLength":100},
        "type":{"enum":["text","email","number","select","textarea"]},
        "required":{"type":"boolean"},
        "options":{"type":"array", "maxItems":20, "items":{"type":"string","minLength":1}},
        "min":{"type":"number"}, "max":{"type":"number"}
      }
    },
    "checklistItem": {
      "type":"object", "additionalProperties":false,
      "required":["id","text","done"],
      "properties": {
        "id":{"type":"string","minLength":1},
        "text":{"type":"string","minLength":1},
        "done":{"type":"boolean"},
        "note":{"type":["string","null"]}
      }
    }
  }
}
