{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://euphoria.example/contracts/visual-surface/v1",
  "title": "EUPHORIA VisualSurface v1/v2 native gallery and isolated artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "surfaceID",
    "revision",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "surfaceID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "enum": [
            "askChoice",
            "askForm",
            "askApproval",
            "showChecklist",
            "pageChecklist",
            "gallery",
            "htmlArtifact"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "options": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "fields": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/checklistItem"
          }
        },
        "gallery": {
          "$ref": "#/$defs/gallery"
        },
        "html": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64000
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "type",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "enum": [
            "text",
            "email",
            "number",
            "select",
            "textarea"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "checklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "done"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "type": "boolean"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "gallery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "record",
            "metrics",
            "notice",
            "table",
            "bar",
            "pie",
            "line",
            "area",
            "progress"
          ]
        },
        "fields": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 100
              },
              "value": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        },
        "metrics": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 100
              },
              "value": {
                "type": "string",
                "maxLength": 2000
              },
              "change": {
                "type": "string",
                "maxLength": 200
              },
              "changeTone": {
                "enum": [
                  "neutral",
                  "positive",
                  "caution",
                  "negative"
                ]
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        },
        "status": {
          "type": "string",
          "maxLength": 100
        },
        "tone": {
          "enum": [
            "neutral",
            "positive",
            "caution",
            "negative"
          ]
        },
        "body": {
          "type": "string",
          "maxLength": 4000
        },
        "bullets": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "columns": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cells": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": [
                    "string",
                    "number"
                  ],
                  "maxLength": 2000
                }
              }
            },
            "required": [
              "cells"
            ]
          }
        },
        "points": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 120
              },
              "value": {
                "type": "number"
              },
              "target": {
                "type": "number"
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        },
        "labels": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "series": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "values": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "name",
              "values"
            ]
          }
        }
      },
      "required": [
        "kind"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "nodes": {
            "contains": {
              "properties": {
                "kind": {
                  "enum": [
                    "gallery",
                    "htmlArtifact"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      }
    }
  ]
}
