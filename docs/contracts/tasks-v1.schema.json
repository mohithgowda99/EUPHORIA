{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://euphoria.example/contracts/tasks/v1",
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "instruction",
        "sessionID",
        "status",
        "resolvedAt",
        "createdAt",
        "updatedAt",
        "deliveryPhase",
        "pendingNodeIDs",
        "failure"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "sessionID": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "needs_input",
            "working",
            "resolved",
            "failed",
            "ready_for_review"
          ]
        },
        "resolvedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "deliveryPhase": {
          "type": "string"
        },
        "pendingNodeIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "instruction"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "mutationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "$ref": "#/$defs/task"
        }
      }
    }
  },
  "$ref": "#/$defs/response"
}
